# --- LLM provider selection --------------------------------------------
# One of: gemini, groq, mistral, openai
LLM_PROVIDER=gemini
LLM_MODEL=gemini-1.5-flash

GEMINI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
OPENAI_API_KEY=

# --- GitHub --------------------------------------------------------------
# Optional for public repos, required for private repos / higher rate limits.
GITHUB_TOKEN=
GITHUB_API_BASE_URL=https://api.github.com

# --- RAG / ChromaDB --------------------------------------------------------
CHROMA_DB_PATH=./data/chroma
CHROMA_COLLECTION_NAME=pr_review_agent
RAG_CHUNK_SIZE=200
RAG_CHUNK_OVERLAP=20
RAG_TOP_K=8

# --- App -------------------------------------------------------------
LOG_LEVEL=INFO
APP_NAME=PR Review Agent
